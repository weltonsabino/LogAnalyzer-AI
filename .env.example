# OpenAI API Configuration
OPENAI_API_KEY=your_key_here

# Groq API Configuration (grátis)
GROQ_API_KEY=your_key_here

# LLM Provider Selection
# Opções: openai (padrão, pago) ou groq (grátis)
LLM_PROVIDER=openai

# Project Configuration
LOG_FILE_PATH=/path/to/logs
PROJECT_NAME=LogAnalyzer AI

# Development
DEBUG=False

# n8n Webhook Integration (Low-Code)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/loganalyzer
N8N_WEBHOOK_ENABLED=true
N8N_EMAIL_TO=seu-email@exemplo.com
N8N_EMAIL_FROM=seu-email@exemplo.com
